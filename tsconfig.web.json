{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/app/*"],
      "@domain/*": ["./src/domain/*"],
      "@contract/*": ["./src/contract/*"]
    }
  },
  "include": [
    "src/app",
    "src/domain",
    "src/contract",
    "src/connectors",
    "tests/app",
    "tests/e2e-app/http",
    "tests/lint/fixtures",
    "eslint.plain-words.d.ts"
  ],
  "exclude": ["tests/app/e2e"]
}
