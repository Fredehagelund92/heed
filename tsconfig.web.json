{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.web.tsbuildinfo"
  },
  "include": [
    "src/web",
    "src/domain",
    "src/contract",
    "src/connectors",
    "tests/unit",
    "eslint.plain-words.d.ts",
    "tests/lint/fixtures",
    ".storybook/preview.tsx"
  ]
}
