    {
      "ref": "dbt:orders.gross_margin",
      "kind": "metric",
      "name": "orders.gross_margin",
      "title": "Gross margin",
      "descriptionCopy": "Gross margin is revenue less the cost of the goods sold, as booked by the invented shop's finance team at the end of each day. It leaves out shipping, which the shop books apart, and returns, which reduce revenue only on the day they arrive. A margin read before the day is closed is provisional and may move by a few percent. This sentence is here to make the description longer than five hundred characters, so that the connector must cut it and say so with a warning, never silently, never by gues",
      "valueType": "sum",
      "visibleGroups": null,
      "areaHint": "sales",
      "domainSource": "source",
