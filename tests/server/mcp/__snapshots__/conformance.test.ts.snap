    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Checks the dates, metrics and markets in a question. No AI is used. Call get_facts before answering a question about company data. Check the dates, definitions and markets of a question, the same way every time. Suggests comparisons, overlapping events and guides that apply.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "dimension_filters": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "description": "A dimension by its name, or the member name you queried (view.member).",
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "values": {
                  "items": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string",
                  },
                  "maxItems": 50,
                  "type": "array",
                },
              },
              "required": [
                "dimension",
                "values",
              ],
              "type": "object",
            },
            "maxItems": 10,
            "type": "array",
          },
          "edition": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$",
            "type": "string",
          },
          "metrics": {
            "description": "Metric names as people say them, their other names, or the member names you queried in the data tool (view.member, such as payments.orders).",
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "question": {
            "maxLength": 2000,
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
            },
            "required": [
              "from",
              "to",
            ],
            "type": "object",
          },
        },
        "required": [
          "question",
        ],
        "type": "object",
      },
      "name": "improve_question",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
