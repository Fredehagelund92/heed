    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Tell the owner something is missing, wrong or unclear. Ask the person first. kind says what: missing, wrong, unclear, or helped. Pass the reply_id of the get_context reply it is about, and context_id when it is about one item; for something missing with no reply, pass the question's metrics, markets and dates instead. It records what was reported and where, so the owner of the domain sees it, and never who asked. The question is read in memory only. Never put question text, personal data or secrets in the optional short note.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "context_id": {
            "description": "The id of the item it is about, when it is about one.",
            "pattern": "^itm_[a-z0-9]{8,16}$",
            "type": "string",
          },
          "dimension_filters": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "description": "A dimension by its name, or the member name you queried (view.member).",
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "values": {
                  "items": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string",
                  },
                  "maxItems": 50,
                  "type": "array",
                },
              },
              "required": [
                "dimension",
                "values",
              ],
              "type": "object",
            },
            "maxItems": 10,
            "type": "array",
          },
          "kind": {
            "description": "missing: something the person needs is not written down. wrong: an item says something that is not true. unclear: it is hard to read or to use. helped: it helped.",
            "enum": [
              "missing",
              "wrong",
              "unclear",
              "helped",
            ],
            "type": "string",
          },
          "metrics": {
            "description": "Metric names as people say them, their other names, or the member names you queried in the data tool (view.member, such as payments.orders).",
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "note": {
            "description": "A short note in the person's words, if they gave one. Never the question text, personal data or secrets.",
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
          "question": {
            "description": "For missing without a reply_id: the question, read in memory only for its metrics, markets and dates, never kept.",
            "maxLength": 2000,
            "type": "string",
          },
          "reply_id": {
            "description": "The reply_id of the get_context reply it is about.",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
            },
            "required": [
              "from",
              "to",
            ],
            "type": "object",
          },
        },
        "required": [
          "kind",
        ],
        "type": "object",
      },
      "name": "report",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": {},
        "properties": {
          "next": {
            "description": "What to do next with this result: for you, not the person. When nothing was found, it says why that proves nothing and which call to make.",
            "minLength": 1,
            "type": "string",
          },
          "recorded": {
            "type": "boolean",
          },
          "say": {
            "description": "What you may tell the person about this result, in these words: plain sentences on what was read and what was found.",
            "minLength": 1,
            "type": "string",
          },
          "status": {
            "type": "string",
          },
          "to": {
            "description": "Who will see it, as a role: the owner of a domain.",
            "type": "string",
          },
        },
        "required": [
          "say",
          "status",
        ],
        "type": "object",
      },
      "title": "Tell the owner",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Send a suggestion to the owner, after the person says yes. Call it only after the person says yes to sending it. It sends a suggestion, a new item or a change to one, as the signed-in person, to the owner of its domain, who checks it and publishes it: nothing changes until they do, and it never publishes. Only what can be worked out is filled in, and every field is marked for the owner. If the review checks find a problem, it is kept as the person's draft and the reply says why. You may suggest the kind, title, summary, body, where it applies, when it applies, where it comes from and what not to conclude. The domain, owner, review date, references and definition marks are worked out for you, the cause, risk level and audience take their defaults, and the mentions, who stated the effect, the stated effect, replaces and conflicts are never filled from what you pass. Pass the words and names: they're matched to the vocabulary, so never invent a metric key or a link, and give a date the person is unsure of only with window.uncertain. Don't include names of customers or staff, personal data, secrets, question text or a transcript. If your agent can show forms, the person may be asked its open questions there before it is sent; their answers are marked as confirmed. If it lists possible duplicates, ask the person, then call again with item_id or new_item. For a law or a regulation, suggest an event: the window from the day it takes effect as its text says, evidence from the official text, and not_to_conclude saying that it is not legal advice and whether the measure is provisional. Tell the person it waits for the owner, and give them the link. How to write a draft: The summary is what agents read first: at most 280 characters, in plain words, saying what happened, where and when, so that it stands alone. Detail, caveats and what the item does not mean go in the body and in what not to conclude, never in the summary. Claim no cause unless the source states one. Name metrics and markets as the person does: the product matches their names to its own, so never invent a key. When the person is unsure of the date or gives none, draft anyway with your best start date, flag the dates as uncertain and say what you assumed; ask only for what you cannot fill. One fact per item: two things that happened are two items.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "area": {
            "description": "The domain, only when the person chose one after a reply asked.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
          },
          "evidence": {
            "description": "Each source the person gave or you read: the address of the exact page, and one sentence copied character for character from that page in the page's own language, never a translation, a summary or a search snippet. Prefer the official text, such as a law on a government site, to a news report of it. Never invent one: if you only saw a summary of a page, leave it out and say so.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "quote": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string",
                },
                "url": {
                  "maxLength": 2000,
                  "type": "string",
                },
              },
              "required": [
                "url",
                "quote",
              ],
              "type": "object",
            },
            "maxItems": 5,
            "type": "array",
          },
          "item_id": {
            "description": "To suggest a change to an accepted item instead of a new one.",
            "pattern": "^itm_[a-z0-9]{8,16}$",
            "type": "string",
          },
          "kind": {
            "description": "event: something that happened on a day. issue: a data problem that lasts a while. note: a lasting remark. guide: how to investigate. example: a checked answer to a question.",
            "enum": [
              "note",
              "event",
              "guide",
              "example",
              "issue",
            ],
            "type": "string",
          },
          "new_item": {
            "description": "true when the person said it is new after a reply listed possible duplicates.",
            "type": "boolean",
          },
          "not_to_conclude": {
            "description": "What not to conclude from this, in the person's words, if they said. Otherwise "cause not proven" is used.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
          "scope": {
            "additionalProperties": false,
            "description": "Names, as in your last get_context call. They're matched to the vocabulary.",
            "properties": {
              "dimension_filters": {
                "description": "Dimensions and the values it applies to, such as market Norway. No values means every value.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "dimension": {
                      "description": "A dimension by its name, or the member name you queried (view.member).",
                      "maxLength": 160,
                      "minLength": 1,
                      "type": "string",
                    },
                    "values": {
                      "items": {
                        "maxLength": 160,
                        "minLength": 1,
                        "type": "string",
                      },
                      "maxItems": 50,
                      "type": "array",
                    },
                  },
                  "required": [
                    "dimension",
                    "values",
                  ],
                  "type": "object",
                },
                "maxItems": 10,
                "type": "array",
              },
              "metrics": {
                "description": "Metric names, as you used them with get_context.",
                "items": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "maxItems": 10,
                "type": "array",
              },
            },
            "type": "object",
          },
          "summary": {
            "description": "One or two sentences an agent reads first, at most 280 characters. Do not claim a cause.",
            "maxLength": 280,
            "minLength": 1,
            "type": "string",
          },
          "text": {
            "description": "What the person wants recorded, in their words or a short summary of them: what happened, where and since when. Not a transcript.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
          "title": {
            "description": "A short title, if you have one.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "description": "Inclusive UTC dates the person named or that the source gives. When they are unsure, give your best start with uncertain: true. Leave out to when it is open.",
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
              "uncertain": {
                "description": "True when the person is unsure of the dates: from is your best guess, and the owner sees the dates flagged.",
                "type": "boolean",
              },
            },
            "required": [
              "from",
            ],
            "type": "object",
          },
        },
        "required": [
          "text",
        ],
        "type": "object",
      },
      "name": "suggest_context",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
