              ],
              "type": "object",
            },
            "type": "array",
          },
          "draft_id": {
            "type": "string",
          },
          "fields": {
            "additionalProperties": {
              "additionalProperties": false,
              "properties": {
                "mark": {
                  "enum": [
                    "derived",
                    "default",
                    "prefilled",
                    "confirmed",
                    "not_inferred",
                  ],
                  "type": "string",
                },
                "reason": {
                  "type": "string",
                },
                "value": {},
