    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Tells the owners that an AI agent found nothing written down for a question. It doesn't record who asked. Report that nothing is written down for a question about metrics, markets and dates that are in the vocabulary (a gap). The question is used only in memory. Never put question text, personal data or secrets in the optional short note.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "dimension_filters": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "description": "A dimension by its name, or the member name you queried (view.member).",
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "values": {
                  "items": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string",
                  },
                  "maxItems": 50,
                  "type": "array",
                },
              },
              "required": [
                "dimension",
                "values",
              ],
              "type": "object",
            },
            "maxItems": 10,
            "type": "array",
          },
          "metrics": {
            "description": "Metric names as people say them, their other names, or the member names you queried in the data tool (view.member, such as payments.orders).",
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "note": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
          "question": {
            "maxLength": 2000,
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
            },
            "required": [
              "from",
              "to",
            ],
            "type": "object",
          },
        },
        "required": [
          "question",
        ],
        "type": "object",
      },
      "name": "report_gap",
      "title": "Report something missing",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Records whether the facts in an answer helped. Say whether the facts in one reply helped, by its delivery_id. Never put question text, personal data or secrets in the optional short note.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "delivery_id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "note": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
          "verdict": {
            "enum": [
              "helpful",
              "wrong",
              "missing",
              "unclear",
            ],
            "type": "string",
          },
        },
        "required": [
          "delivery_id",
          "verdict",
        ],
        "type": "object",
      },
      "name": "give_feedback",
      "title": "Say if it helped",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Saves a draft for you to check and send. Save a draft of a fact (a context item) for the signed-in person, when they ask to record something from this work. Only what can be worked out is filled in, and every field is marked; it never sends the draft for review. You may suggest the kind, title, summary, body, where it applies, when it applies, where it comes from and what not to conclude. The domain, owner, review date, references and definition marks are worked out for you, the cause, risk level and audience take their defaults, and the mentions, who stated the effect, the stated effect, replaces and conflicts are never filled from what you pass. Pass the words and names: they're matched to the vocabulary, so never invent a metric key or a link, and give a date the person is unsure of only with window.uncertain. Don't include names of customers or staff, personal data, secrets, question text or a transcript. If your agent can show forms, the person may be asked its open questions there before it saves; their answers are marked as confirmed. If it lists possible duplicates, ask the person, then call again with item_id or new_item. For a law or a regulation, draft an event: the window from the day it takes effect as its text says, evidence from the official text, and not_to_conclude saying that it is not legal advice and whether the measure is provisional. Show the person the questions and the link, and let them check the draft and send it for review in Heed. How to write a draft: The summary is what agents read first: at most 280 characters, in plain words, saying what happened, where and when, so that it stands alone. Detail, caveats and what the item does not mean go in the body and in what not to conclude, never in the summary. Claim no cause unless the source states one. Name metrics and markets as the person does: the product matches their names to its own, so never invent a key. When the person is unsure of the date or gives none, draft anyway with your best start date, flag the dates as uncertain and say what you assumed; ask only for what you cannot fill. One fact per item: two things that happened are two items.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "area": {
            "description": "The domain, only when the person chose one after a reply asked.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
          },
          "evidence": {
            "description": "Each source the person gave or you read: the address of the exact page, and one sentence copied character for character from that page in the page's own language, never a translation, a summary or a search snippet. Prefer the official text, such as a law on a government site, to a news report of it. Never invent one: if you only saw a summary of a page, leave it out and say so.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "quote": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string",
                },
                "url": {
                  "maxLength": 2000,
                  "type": "string",
                },
              },
              "required": [
                "url",
                "quote",
              ],
              "type": "object",
            },
            "maxItems": 5,
            "type": "array",
          },
          "item_id": {
            "description": "To suggest a change to an accepted item instead of a new one.",
            "pattern": "^itm_[a-z0-9]{8,16}$",
            "type": "string",
          },
          "kind": {
            "description": "event: something that happened on a day. issue: a data problem that lasts a while. note: a lasting remark. guide: how to investigate. example: a checked answer to a question.",
            "enum": [
              "note",
              "event",
              "guide",
              "example",
              "issue",
            ],
            "type": "string",
          },
          "new_item": {
            "description": "true when the person said it is new after a reply listed possible duplicates.",
            "type": "boolean",
          },
          "not_to_conclude": {
            "description": "What not to conclude from this, in the person's words, if they said. Otherwise "cause not proven" is used.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
          "scope": {
            "additionalProperties": false,
            "description": "Names, as in your last get_facts call. They're matched to the vocabulary.",
            "properties": {
              "dimension_filters": {
                "description": "Dimensions and the values it applies to, such as market Norway. No values means every value.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "dimension": {
                      "description": "A dimension by its name, or the member name you queried (view.member).",
                      "maxLength": 160,
                      "minLength": 1,
                      "type": "string",
                    },
                    "values": {
                      "items": {
                        "maxLength": 160,
                        "minLength": 1,
                        "type": "string",
                      },
                      "maxItems": 50,
                      "type": "array",
                    },
                  },
                  "required": [
                    "dimension",
                    "values",
                  ],
                  "type": "object",
                },
                "maxItems": 10,
                "type": "array",
              },
              "metrics": {
                "description": "Metric names, as you used them with get_facts.",
                "items": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "maxItems": 10,
                "type": "array",
              },
            },
            "type": "object",
          },
          "summary": {
            "description": "One or two sentences an agent reads first, at most 280 characters. Do not claim a cause.",
            "maxLength": 280,
            "minLength": 1,
            "type": "string",
          },
          "text": {
            "description": "What the person wants recorded, in their words or a short summary of them: what happened, where and since when. Not a transcript.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
          "title": {
            "description": "A short title, if you have one.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "description": "Inclusive UTC dates the person named or that the source gives. When they are unsure, give your best start with uncertain: true. Leave out to when it is open.",
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
              "uncertain": {
                "description": "True when the person is unsure of the dates: from is your best guess, and the owner sees the dates flagged.",
                "type": "boolean",
              },
            },
            "required": [
              "from",
            ],
            "type": "object",
          },
        },
        "required": [
          "text",
        ],
        "type": "object",
      },
      "name": "draft_context",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": {},
        "properties": {
          "answered": {
            "items": {
              "enum": [
