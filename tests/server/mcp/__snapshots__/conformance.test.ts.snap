          "flags": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "may_be_high_risk",
                    "instruction_like_text",
                    "uncertain_dates",
                  ],
                  "type": "string",
                },
                "field": {
                  "enum": [
                    "kind",
