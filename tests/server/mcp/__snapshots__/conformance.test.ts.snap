                  "type": "object",
                },
                "maxItems": 10,
                "type": "array",
              },
              "metrics": {
                "description": "Metric names, as you used them with get_context.",
                "items": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "maxItems": 10,
                "type": "array",
              },
            },
            "type": "object",
          },
          "summary": {
            "description": "One or two sentences an agent reads first, at most 280 characters. Do not claim a cause.",
            "maxLength": 280,
            "minLength": 1,
            "type": "string",
