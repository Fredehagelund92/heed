                    "replaces",
                    "conflicts",
                  ],
                  "type": "string",
                },
                "words": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "required": [
                "code",
                "field",
                "words",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "instructions": {
            "type": "string",
          },
          "message": {
            "type": "string",
          },
          "not_in_vocabulary": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                },
                "suggestions": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "required": [
