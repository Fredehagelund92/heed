            "pattern": "^itm_[a-z0-9]{8,16}$",
            "type": "string",
          },
          "kind": {
            "description": "event: something that happened on a day. issue: a data problem that lasts a while. note: a lasting remark. guide: how to investigate. example: a checked answer to a question.",
            "enum": [
              "note",
              "event",
              "guide",
              "example",
              "issue",
            ],
            "type": "string",
          },
          "new_item": {
            "description": "true when the person said it is new after a reply listed possible duplicates.",
            "type": "boolean",
          },
          "not_to_conclude": {
            "description": "What not to conclude from this, in the person's words, if they said. Otherwise "cause not proven" is used.",
