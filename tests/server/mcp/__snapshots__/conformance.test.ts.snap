  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "The context that applies to a question, with one sentence to relay. Call get_context before answering a question about company data. Pass structured metrics, dimension_filters and inclusive UTC dates when known. Without window, the dates in the question are read (such as 2026, last quarter or 1 Jan to 30 Sep) and say says how; without any dates, the question is read at today and say says so. The member names you just queried in the data tool work as names, and a name that isn't known comes back with the closest that is. A dimension filter with no values names the dimension for every value, as in a breakdown by market. Returns status, the answer state; say, the sentence to relay, which starts with the answer line; asked, what was looked up; and context, each item that applies with its kind, when and where it applies, who checked it and when, its source, its not_to_conclude line, whether it may be out of date and which item it disagrees with; then reply_id, for report, and the edition. With response_format full, each item also has its body, every source and its links. A link neither widens where an item applies nor proves a cause. Read a linked item with read_context only when it helps answer the question.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "dimension_filters": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "description": "A dimension by its name, or the member name you queried (view.member).",
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "values": {
                  "items": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string",
                  },
                  "maxItems": 50,
                  "type": "array",
                },
              },
              "required": [
                "dimension",
                "values",
              ],
              "type": "object",
            },
            "maxItems": 10,
            "type": "array",
          },
          "edition": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$",
            "type": "string",
          },
          "max_bytes": {
            "default": 100000,
            "maximum": 100000,
            "minimum": 1000,
            "type": "integer",
          },
          "max_items": {
            "default": 20,
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
          },
          "metrics": {
            "description": "Metric names as people say them, their other names, or the member names you queried in the data tool (view.member, such as payments.orders).",
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "question": {
            "maxLength": 2000,
            "type": "string",
          },
          "response_format": {
            "default": "concise",
            "description": "concise (the default): the answer line, say, what was asked, and each item that applies with its source and who checked it. full: also each item's body, every source, its links, and how the question was read (scope_used, dates_read, definitions, check_report). Ask for full when you will quote an item's text or follow its links.",
            "enum": [
              "concise",
              "full",
            ],
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
            },
            "required": [
              "from",
              "to",
            ],
            "type": "object",
          },
        },
        "required": [
          "question",
        ],
        "type": "object",
      },
      "name": "get_context",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": {},
        "properties": {
          "asked": {
            "description": "What was looked up: the metrics, markets and dates, in words.",
            "type": [
              "string",
              "null",
            ],
          },
          "context": {
            "items": {
              "additionalProperties": {},
              "properties": {
                "checked": {
                  "additionalProperties": false,
                  "description": "Who checked it before agents got it, as a role (never a person), and on which day.",
                  "properties": {
                    "date": {
                      "type": "string",
                    },
                    "role": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "role",
                    "date",
                  ],
                  "type": "object",
                },
                "id": {
                  "type": "string",
                },
                "kind": {
                  "description": "event, warning, rule or guide.",
                  "type": "string",
                },
                "title": {
                  "type": "string",
                },
                "url": {
                  "description": "The item's page, for the person: link it where you cite the item.",
                  "type": "string",
                },
              },
              "required": [
                "id",
                "title",
                "kind",
                "url",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "edition": {
            "type": "string",
          },
          "next": {
            "description": "What to do next with this result: for you, not the person. When nothing was found, it says why that proves nothing and which call to make.",
            "minLength": 1,
            "type": "string",
          },
          "reply_id": {
            "description": "The id of this reply, for report when the person says what was wrong or helped.",
            "type": "string",
          },
          "say": {
            "description": "What you may tell the person about this result, in these words: plain sentences on what was read and what was found.",
            "minLength": 1,
            "type": "string",
          },
          "status": {
            "description": "The answer state: matched (Checked), partial (Partial), no_match (Not found), conflict (Conflict), stale (Outdated), check_failed (Not checked); need_more_detail when the question could not be read.",
            "enum": [
              "matched",
              "partial",
              "no_match",
              "conflict",
              "stale",
              "check_failed",
              "need_more_detail",
            ],
            "type": "string",
          },
        },
        "required": [
          "say",
          "status",
        ],
        "type": "object",
      },
      "title": "Get context for a question",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "A word search over names, titles and summaries. Call get_context before answering a question about company data. Find what is written down about a few words, by the names people use: metrics and their other names (such as GMV), markets, domains, member names from the data tool (such as payments.orders), and words in an item's title, summary or text. Use it for "what do we know about", "what is" or "how is it defined", and when you don't know the exact names. Filter by domain (a name such as Sales) or kind (event, warning, rule or guide). Returns the matching items, titles and summaries only, and for each metric or dimension the words name: the definition its source gives and what this context adds. When no words match, it returns the items that apply to what the words name, on the dates the window or the words give, or else today, as say says; when nothing is found, why says what to try. Read an item in full with read_context.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "domain": {
            "description": "A domain by its name, such as Sales (its id, such as area_sales, works too).",
            "maxLength": 80,
            "minLength": 1,
            "type": "string",
          },
          "edition": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$",
            "type": "string",
          },
          "kind": {
            "description": "Only items of this kind: event, warning, rule or guide.",
            "enum": [
              "event",
              "warning",
              "rule",
              "guide",
            ],
            "type": "string",
          },
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
          },
          "max_bytes": {
            "default": 100000,
            "maximum": 100000,
            "minimum": 1000,
            "type": "integer",
          },
          "query": {
            "description": "A few words or the question as asked: a metric, a market, a domain or a topic, such as "GMV Spain" or "what is net revenue".",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
          "response_format": {
            "default": "concise",
            "description": "concise (the default): each definition without where its source keeps it. full: every source detail. Read an item in full with read_context.",
            "enum": [
              "concise",
              "full",
            ],
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "description": "Inclusive UTC dates, for the items that apply when no words match. Today when left out.",
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
            },
            "required": [
              "from",
              "to",
            ],
            "type": "object",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
