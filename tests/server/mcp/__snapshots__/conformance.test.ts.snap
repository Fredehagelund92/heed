    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Follow a link between facts, definitions and domains, one step at a time. Call get_context before answering a question about company data. Follow links from an item's id, a vocabulary key such as metric:orders, or a domain. Returns neighbours one or two steps away with their kind of link, never bodies. A link shows what a text refers to: it neither widens where an item applies nor proves a cause, and it never changes what get_context includes. Call it only when a link helps answer the question; read a neighbour with read_context. Follow next_cursor for another page.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "maxLength": 2000,
            "type": "string",
          },
          "depth": {
            "default": 1,
            "maximum": 2,
            "minimum": 1,
            "type": "integer",
          },
          "edition": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$",
            "type": "string",
          },
          "id": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string",
          },
          "max_bytes": {
            "default": 100000,
            "maximum": 100000,
            "minimum": 1000,
            "type": "integer",
          },
          "max_nodes": {
            "default": 20,
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
          },
          "relations": {
            "items": {
              "enum": [
                "replaces",
                "replaced_by",
                "conflicts_with",
                "applies_to",
                "mentions",
                "mentioned_by",
                "in_area",
              ],
              "type": "string",
            },
            "maxItems": 7,
            "minItems": 1,
            "type": "array",
          },
          "window": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
            },
            "required": [
              "from",
              "to",
            ],
            "type": "object",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "name": "get_related",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": {},
        "properties": {
          "next": {
            "description": "What to do next with this result: for you, not the person. When nothing was found, it says why that proves nothing and which call to make.",
            "minLength": 1,
            "type": "string",
          },
          "say": {
            "description": "What you may tell the person about this result, in these words: plain sentences on what was read and what was found.",
            "minLength": 1,
            "type": "string",
          },
          "status": {
            "type": "string",
          },
        },
        "required": [
          "say",
          "status",
        ],
        "type": "object",
      },
      "title": "Follow links",
    },
  ],
}
`;
