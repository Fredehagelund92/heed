# The service's configuration (src/server/config/env.ts). Copy this file to .env.local and adjust;
# `npm run dev:server` loads .env.local when it exists. Never commit .env.local.

# development, test or production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# The local PostgreSQL 18 database the service uses (docs/operations.md, "Run the service locally")
DATABASE_URL=postgres://context_layer_api@localhost:5432/context_layer_dev
# Owner for forward-only migrations (`npm run db:migrate`); serving pool uses its restricted role.
DATABASE_URL_MIGRATE=postgres://context_layer_owner@localhost:5432/context_layer_dev
DATABASE_URL_SERVE=postgres://context_layer_serve@localhost:5432/context_layer_dev
# The local superuser: `npm run db:migrate` creates the roles and the database with it when they are
# missing, and loads the demo with it. Leave it empty where the roles and database are made for you.
DATABASE_URL_BOOTSTRAP=postgres://localhost:5432/postgres
# on: `npm run db:migrate` loads the demo (invented people, domains and facts) into a database that
# holds nothing yet, beside the demo Cube model only. Off when empty; refused in production.
SEED_DEMO=on
# `npm run seed`: an empty local context_layer_dev or context_layer_test database, as a superuser.
DATABASE_URL_SEED=postgres://localhost:5432/context_layer_dev

# Sign-in: dev picks a person from a local file (demo is the same picker, for demos); both are
# refused when NODE_ENV=production. oidc signs people in with the company's OpenID Connect provider
# and is the default in production (docs/ai-sign-in.md).
CL_AUTH=dev
# CL_AUTH=oidc: the provider's issuer and this app's client id there; a confidential client's
# secret in an owner-only file (chmod 600), never here.
CL_OIDC_ISSUER=
CL_OIDC_CLIENT_ID=
CL_OIDC_CLIENT_SECRET_FILE=
# Default: the origin of MCP_RESOURCE_URL at /api/v1/auth/oidc/callback.
CL_OIDC_REDIRECT_URL=
# Groups (comma-separated) whose members may sign in without an invite, and the claim that lists them.
CL_OIDC_ADMIN_GROUPS=
CL_OIDC_MEMBER_GROUPS=
CL_OIDC_GROUPS_CLAIM=groups
# The provider's name on the sign-in button, such as Okta.
CL_OIDC_NAME=
# A browser session ends after this many hours unused, and this many days after sign-in.
CL_SESSION_IDLE_HOURS=12
CL_SESSION_MAX_DAYS=7
# Allowed local identities. Global roles bootstrap once; later changes use the role API.
# Browser mutations require an exact allowed origin and the X-Heed-CSRF header.
CL_DEV_PEOPLE_FILE=db/seed/people.local.yml
CL_WEB_ORIGINS=http://localhost:5173,http://localhost:4173
# Pins the service's day (YYYY-MM-DD) so demo runs match the fixtures. Refused in production.
CL_FIXED_TODAY=

# Language models for the evaluation runner, its judges and the assistant: mock (default, scripted,
# no network) or live. Live uses each role's provider and model from the settings (models.eval_answer,
# models.judge, models.assistant, models.test_authoring), and the provider's key from here, in
# .env.local only. Questions and answers then leave the company to the named provider and the
# model's vendor: real company data needs company approval of them first.
# `npm run eval -- --real` and `npm run eval:assistant -- --real` run live without changing this.
MODELS=mock
# Provider anthropic: the Anthropic API directly.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Provider vercel-gateway: Vercel AI Gateway (OpenAI-compatible), serving Anthropic's Claude models and
# Google's google/gemini-2.5-flash-lite. A Gemini model sends questions and answers to Vercel and Google.
# VERCEL_AI_GATEWAY_API_KEY=
# VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# A folder of Cube model files, read offline. db/seed/cube is the demo model the bulk seed
# stores (docs/connectors/cube.md). Leave empty to use two invented demo definitions instead.
CUBE_MODEL_DIR=db/seed/cube
# Optional JSON file: {"view_name":"area_id"}. Fills gaps; Cube metadata wins.
CL_DOMAIN_OVERRIDES=
# Optional JSON file: {"cube:old_view.member":"cube:new_view.member"}. Names the new id when a member is renamed.
CUBE_RENAMES_FILE=
# Optional: how long Cube's compiler may take on the model, in seconds (default 120), and the memory it
# may use, in MB (default 1024). Raise them for a model of many thousand members.
CUBE_COMPILE_TIMEOUT_SECONDS=
CUBE_COMPILE_MEMORY_MB=
# The local secret store: a folder outside the repository that only the server's user may open
# (mode 0700), for the tokens of sources added in Administration › Sources (docs/connectors/security.md).
# Leave empty to keep no secret; a source that needs one cannot then be added.
CL_SECRETS_DIR=

# on: the assistant's read_source may also open plain http pages on this machine, where the
# end-to-end tests serve theirs. Never another private address; refused in production.
CL_WEB_READ_LOOPBACK=

# The bearer token a scraper presents at /metrics (32+ characters: openssl rand -hex 32).
# Leave empty to keep /metrics off.
CL_METRICS_TOKEN=

# The product's name in what people and agents read: the web app, the help pages, the assistant
# and the MCP server's instructions. The web build reads it too. Leave empty for the default.
CL_PRODUCT_NAME=

# Where people write to support from the web app and its docs site: Contact support and
# Report a problem open a mail to it. Read when they are built. Leave empty for a stand-in address.
CL_SUPPORT_EMAIL=

# Used by `npm run test:integration` only: a superuser, who makes a database per test file. Vitest
# does not read .env.local: export it in your shell.
TEST_DATABASE_URL=postgres://localhost:5432/postgres

# Local HTTP MCP resource and Ed25519 signing key (created with mode 0600; never commit).
MCP_RESOURCE_URL=http://localhost:3000/mcp
MCP_DEV_KEY_FILE=.heed-dev-key.pem

# HMAC key that seals draft_context's questions in a person's agent (hex, owner-only; created
# outside production; every instance needs the same file; never commit).
CL_MCP_STATE_KEY_FILE=.heed-mcp-state.key

# The login server for a person's own agent (docs/ai-sign-in.md): builtin, external or off.
CL_LOGIN_SERVER=builtin
# Ed25519 key that signs access tokens (owner-only; created outside production; never commit).
CL_OAUTH_SIGNING_KEY_FILE=.heed-oauth-key.pem
# Earlier keys that still verify after a rotation, comma separated.
CL_OAUTH_PREVIOUS_KEY_FILES=
# Dynamic client registration, the fallback to client ID metadata documents: on or off.
# Unset defaults to on outside production, off in production; set on to opt in explicitly.
CL_OAUTH_DYNAMIC_REGISTRATION=
# Refresh tokens expire after 7 days idle; connections end 30 days after sign-in.
CL_OAUTH_REFRESH_IDLE_HOURS=168
CL_OAUTH_CONNECTION_DAYS=30
# Optional: the issuer (default: the origin of MCP_RESOURCE_URL) and the consent page (default:
# /connect/approve on the first web origin on the issuer's host).
# CL_OAUTH_ISSUER=http://localhost:3000
# CL_OAUTH_CONSENT_URL=http://localhost:5173/connect/approve
# CL_LOGIN_SERVER=external: another login server's issuer and key set.
# MCP_AUTH_ISSUER=
# MCP_AUTH_JWKS_URL=

# The web app, `npm run dev:http`: reads the service through /api/v1, which the dev and preview
# servers forward to HEED_API_URL (vite.app.config.ts). Vite does not read this file; export them.
# HEED_API_URL=http://127.0.0.1:3000
# The database `npm run test:e2e:seed` serves from: prepared by `npm run db:migrate` with
# SEED_DEMO=on, as a new install is.
# E2E_DATABASE_URL=postgres://context_layer_api@localhost:5432/context_layer_dev

# The command-line tool, `npm run heed -- <command>` (docs/operations.md, "Administration,
# import and export"). It signs in as a person from CL_DEV_PEOPLE_FILE and presents the first of
# CL_WEB_ORIGINS for changes unless HEED_ORIGIN says otherwise.
# HEED_URL=http://127.0.0.1:3000
# HEED_EMAIL=per_maria@example.test
