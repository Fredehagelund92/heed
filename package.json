{
  "name": "heed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A governed library of checked facts that AI agents read before they answer",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "context-engineering",
    "semantic-layer",
    "cube",
    "data-governance",
    "analytics",
    "llm"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "@ai-sdk/openai-compatible": "3.0.85",
    "@ai-sdk/provider": "4.0.36",
    "@base-ui/react": "1.9.0",
    "@cubejs-backend/schema-compiler": "1.7.39",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@orpc/client": "1.16.1",
    "@orpc/contract": "1.16.1",
    "@orpc/json-schema": "1.16.1",
    "@orpc/openapi": "1.16.1",
    "@orpc/openapi-client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/zod": "1.16.1",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tiptap/core": "3.32.3",
    "@tiptap/extension-link": "3.32.3",
    "@tiptap/extension-mention": "3.32.3",
    "@tiptap/extension-placeholder": "3.32.3",
    "@tiptap/markdown": "3.32.3",
    "@tiptap/pm": "3.32.3",
    "@tiptap/react": "3.32.3",
    "@tiptap/starter-kit": "3.32.3",
    "@tiptap/static-renderer": "3.32.3",
    "@tiptap/suggestion": "3.32.3",
    "@vercel/functions": "3.10.6",
    "age-encryption": "0.3.1",
    "ai": "7.0.163",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "diff": "8.0.4",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "minisearch": "7.2.0",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.18.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/router-plugin": "1.168.48",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-boundaries": "7.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:http": "VITE_API_MODE=http vite",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "build:vercel": "node scripts/vercel-build.ts",
    "preview": "vite preview",
    "docs:build": "node scripts/docs-build.ts",
    "docs:preview": "vite preview -c vite.docs.config.ts",
    "docs:sync": "DOCS_SYNC=1 vitest run --project web tests/web/docs.test.ts",
    "site:dev": "npm --prefix apps/docs run dev",
    "site:build": "npm --prefix apps/docs run build",
    "dev:server": "node --env-file-if-exists=.env.local --watch src/server/main.ts",
    "start:server": "node --env-file-if-exists=.env.local src/server/main.ts",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js . && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:words": "node scripts/check-plain-words.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project '!integration'",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:golden-http": "playwright test -c playwright.golden-http.config.ts",
    "test:e2e:seed": "playwright test -c playwright.seed.config.ts",
    "test:e2e:own": "playwright test -c playwright.own-data.config.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:words && npm run format:check && npm test",
    "size": "VITE_API_MODE=http npm run build && node scripts/check-bundle-size.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local db/prepare.ts",
    "db:new-migration": "node scripts/migrations.ts new",
    "db:renumber": "node scripts/migrations.ts renumber",
    "seed": "node --env-file-if-exists=.env.local db/seed/main.ts",
    "db:restore-drill": "node --env-file-if-exists=.env.local src/server/run-restore-drill.ts",
    "db:snapshot": "node --env-file-if-exists=.env.local db/snapshot.ts",
    "token:dev": "node --env-file-if-exists=.env.local src/server/mcp/token-dev.ts",
    "keys:create": "node --env-file-if-exists=.env.local src/server/create-keys.ts",
    "connectors:sync": "node --env-file-if-exists=.env.local src/server/sync-definitions.ts",
    "eval": "node --env-file-if-exists=.env.local src/server/run-evals.ts",
    "eval:ask-words": "node --env-file-if-exists=.env.local src/server/run-ask-words-cases.ts",
    "eval:ask-plan": "node --env-file-if-exists=.env.local src/server/run-ask-plan-cases.ts",
    "eval:ask-gate": "node --env-file-if-exists=.env.local src/server/run-ask-plan-cases.ts --gate",
    "eval:ask-harness": "node --env-file-if-exists=.env.local scripts/ask-eval.ts",
    "eval:drafts": "node scripts/draft-eval.ts",
    "held-out": "node scripts/held-out.ts",
    "heed": "node --env-file-if-exists=.env.local src/cli/main.ts",
    "api:generate": "node scripts/generate-api.ts",
    "cn:generate": "node scripts/generate-cn-tables.ts"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@cubejs-backend/native@1.7.39": true
  },
  "overrides": {
    "basic-ftp": "6.2.4",
    "handlebars": "4.7.10",
    "minimatch": "11.0.3"
  }
}
