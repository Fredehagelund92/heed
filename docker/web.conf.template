# The web app (Dockerfile, `web`): the production build, with /api/v1 forwarded to the service
# at ${HEED_API_URL}, as the Vite preview server does (vite.config.ts). nginx runs as its own
# unprivileged user, so it listens on 8080.

# HSTS only when a proxy in front ends TLS and says so (docs/self-hosting.md, "Put it behind
# HTTPS"). Over plain http it is never sent: a browser would ignore it, and on localhost it would
# pin every other local app to https.
map $http_x_forwarded_proto $heed_hsts {
    https "max-age=31536000";
    default "";
}

server {
    listen 8080;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;
    charset_types text/plain text/css application/javascript application/json image/svg+xml;

    # The image ships each file also gzipped at the highest level (file.gz beside it), served to a
    # browser that accepts gzip. What has no such file, such as the service's JSON, is gzipped as
    # it goes. The session cookie is SameSite=Strict, so another site cannot make a signed-in
    # browser fetch a compressed answer and read its size.
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/markdown application/javascript application/json
        application/manifest+json image/svg+xml image/x-icon;

    location /api/v1/ {
        # The service sets its own security headers on what it answers (src/server/app.ts).
        proxy_pass ${HEED_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    # File names carry their content's hash. One that is not there is missing, not a page.
    location /assets/ {
        include /etc/nginx/heed/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # A file at the top (robots.txt, llms.txt, favicon.svg) is served as it is, and one that is
    # not there is missing, not a page: no address of the app has a dot in its first part.
    location ~ ^/[^/]+\.[^/]+$ {
        include /etc/nginx/heed/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Every other address is a page of the app, which says itself when it does not know one.
    location / {
        include /etc/nginx/heed/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
