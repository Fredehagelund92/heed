# The web app (Dockerfile, `web`): the production build, with /api/v1 forwarded to the service
# at ${HEED_API_URL}, as the Vite preview server does (vite.app.config.ts).
server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/v1/ {
        proxy_pass ${HEED_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    # File names carry their content's hash.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Every other address is a page of the app.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
