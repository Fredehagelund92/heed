{
  "name": "heed-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-site.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.9",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "astro": "7.4.7",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "sharp": "0.35.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "oxlint": "1.91.0",
    "typescript": "6.0.3",
    "vfile": "6.0.3",
    "vitest": "5.1.0"
  }
}
